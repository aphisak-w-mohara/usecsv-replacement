# Local dev overrides for `wrangler dev`. Copy to `.dev.vars` (gitignored).
# wrangler.toml ships ENVIRONMENT="production" (secure default) — these flip the
# worker into the local auth seam so you can run the app without minting real
# Firebase ID tokens. NEVER commit a .dev.vars; never set ENVIRONMENT=local in a
# deployed env (it trusts the X-Dev-Email header / DEV_EMAIL and skips Firebase
# verification).
ENVIRONMENT=local
DEV_EMAIL=aphisak@mohara.co
