# Firebase web (client) config — ALL of these are PUBLIC values: they ship in
# the browser bundle by design. Copy this file to `.env.local` (gitignored) and
# fill in the values from the Firebase console (Project settings → Your apps →
# SDK setup and configuration → Config). Authentication only — authorization
# lives in the worker's D1 (memberships / invites / grants / allowed domain).
#
# DEV note: leave these BLANK in local dev to use the worker's email seam
# (DEV_EMAIL) — `pnpm dev` then works without a real Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
