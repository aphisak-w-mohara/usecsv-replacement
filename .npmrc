# Force pnpm to install platform-specific optional native binaries (e.g.
# rolldown's @rolldown/binding-*) for the host AND for Linux/x64/glibc, so a
# lockfile generated on macOS still installs the Linux binary the CI runner
# needs. Without this, `pnpm install` on CI skipped @rolldown/binding-linux-x64-gnu
# and the Vite (rolldown) web build crashed with "Cannot find native binding".
supportedArchitectures.os[]=current
supportedArchitectures.os[]=linux
supportedArchitectures.cpu[]=current
supportedArchitectures.cpu[]=x64
supportedArchitectures.libc[]=current
supportedArchitectures.libc[]=glibc
