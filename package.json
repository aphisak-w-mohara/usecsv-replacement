{
  "name": "evo-csv",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"@evo-csv/*\" dev",
    "dev:web": "pnpm --filter @evo-csv/web dev",
    "dev:worker": "pnpm --filter @evo-csv/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.0"
  }
}
