{
  "name": "evo-csv",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"@evo-csv/*\" dev",
    "dev:web": "pnpm --filter @evo-csv/web dev",
    "dev:worker": "pnpm --filter @evo-csv/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "bootstrap": "tsx tools/bootstrap.ts"
  },
  "devDependencies": {
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux",
        "darwin",
        "win32"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc",
        "musl"
      ]
    }
  }
}
